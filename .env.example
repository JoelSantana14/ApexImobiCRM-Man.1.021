# Configure these values in Vercel Project Settings > Environment Variables.
# Never use VITE_ on server secrets; every VITE_ variable is exposed to browsers.
GEMINI_API_KEY=""

# Firebase Admin SDK: paste the service-account JSON as one secret value in Vercel.
# Alternatively, on a trusted local server, configure GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_SERVICE_ACCOUNT_JSON=""
APP_URL="https://your-project.vercel.app"

# Optional: set to true only for an isolated demo/test environment. Defaults to false.
VITE_DEMO_MODE="false"

# AWS SES credentials must be configured only in the server's secret manager.
# Never place real values in frontend code, VITE_* variables, or browser localStorage.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="sa-east-1"
AWS_SENDER_EMAIL="remetente-verificado@seudominio.com"
